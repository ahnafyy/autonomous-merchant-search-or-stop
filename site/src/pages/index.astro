---
import RecalledSearchWorkbench from "../components/RecalledSearchWorkbench.astro";
import ResearchLayout from "../layouts/ResearchLayout.astro";
import data from "../generated/site-data.json";

const { claims, links, packages, release, results } = data;
const basePath = import.meta.env.BASE_URL;
const paperHref = `${basePath}paper/`;
const shopify = results.shopify_global_catalog;
const ucpReplay = results.ucp_direct_panels.pandora_replay;
const primaryClaim = claims.find((claim) => claim.id === "UCP-PANDORA-REPLAY-001");
const sensitivityClaim = claims.find((claim) => claim.id === "UCP-MARKET-RATE-SENSITIVITY-001");
const shopifyClaim = claims.find((claim) => claim.id === "PANDORA-ADVANTAGE-001");
---

<ResearchLayout
  title="Agentic Shopping: Search or Stop"
  description="A deterministic, budget-aware decision runtime for shopping agents."
>
  <header class="topbar">
    <div class="journal-mark">
      <a class="wordmark" href={basePath} aria-label="Agentic Shopping: Search or Stop, home">Search or Stop</a>
      <span>Decision runtime for shopping agents</span>
    </div>
    <nav aria-label="Primary navigation">
      <a href="#try">Try it</a>
      <a href="#install">Install</a>
      <a href="#evidence">Evidence</a>
      <a href={paperHref}>Paper</a>
      <a href={links.repository}>GitHub</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero product-hero" aria-labelledby="product-title">
      <div class="product-intro">
        <div class="article-kicker">
          <span>Python + JavaScript + Agent Skill</span>
          <span>Version {release.version}</span>
          <span>MIT licensed</span>
        </div>
        <h1 id="product-title">Know when one more seller is worth it.</h1>
        <p class="subtitle">A deterministic decision layer for shopping agents that balances expected savings against time, tokens, API calls, and money.</p>
        <p class="product-summary">Keep merchant tools and purchase authority in your host. Give the model a narrow, auditable `SEARCH` or `STOP` tool instead of asking it to improvise the economics.</p>
        <div class="product-actions">
          <a class="action-link action-link--primary" href="#try">Try the decision tool</a>
          <a class="action-link" href="#install">Choose an integration</a>
        </div>
      </div>
      <div id="try" class="product-tool">
        <RecalledSearchWorkbench />
      </div>
    </section>

    <section class="section" id="install" aria-labelledby="install-title">
      <div class="section__heading">
        <p class="section-number">1</p>
        <div><span class="eyebrow">Install</span><h2 id="install-title">Use it from your stack</h2></div>
      </div>
      <div class="integration-grid">
        <article class="integration">
          <span class="integration__label">Python</span>
          <h3>Agent runtime</h3>
          <code>pip install {packages.python.distribution}</code>
          <a href={`${links.repository}/tree/main/packages/python`}>Python guide</a>
        </article>
        <article class="integration">
          <span class="integration__label">JavaScript</span>
          <h3>Browser and Node runtime</h3>
          <code>npm install {packages.javascript.name}</code>
          <a href={`${links.repository}/tree/main/packages/javascript`}>JavaScript guide</a>
        </article>
        <article class="integration">
          <span class="integration__label">Agent Skill</span>
          <h3>Cross-agent procedure</h3>
          <code>npx skills add ahnafyy/autonomous-merchant-search-or-stop</code>
          <a href="https://skills.sh/ahnafyy/autonomous-merchant-search-or-stop">Skills.sh listing</a>
        </article>
      </div>
    </section>

    <section class="section" id="evidence" aria-labelledby="evidence-title">
      <div class="section__heading">
        <p class="section-number">2</p>
        <div><span class="eyebrow">Evidence</span><h2 id="evidence-title">The useful claim is cost sensitivity</h2></div>
      </div>
      <p class="section-intro">The runtime does not claim that adaptive stopping always wins. Its value appears when inspections have material cost; at zero cost, opening every feasible seller is the correct baseline.</p>
      <div class="evidence-grid">
        <article class="evidence-panel evidence-panel--primary">
          <span class="evidence-panel__label">Primary held-out result</span>
          <h3>{ucpReplay.held_out_product_count.toLocaleString()} SKU clusters</h3>
          <p>{primaryClaim?.detail}</p>
          <small>Declared rate-card scenarios, not observed billing. Catalog cards are not verified checkout offers.</small>
        </article>
        <article class="evidence-panel">
          <span class="evidence-panel__label">Boundary result</span>
          <h3>Cost changes the answer</h3>
          <p>{sensitivityClaim?.detail}</p>
          <small>Zero cost favors search-all; very low positive costs remain inconclusive.</small>
        </article>
        <article class="evidence-panel evidence-panel--caution">
          <span class="evidence-panel__label">Exploratory replication</span>
          <h3>{shopify.held_out_product_count} Shopify products</h3>
          <p>{shopifyClaim?.detail}</p>
          <small>Title identity changed after collection; only the highest-cost scenario favors adaptive stopping.</small>
        </article>
      </div>
      <p class="evidence-link"><a href={paperHref}>Read the paper, intervals, methods, and executable claim ledger</a></p>
    </section>

    <section class="section section--materials" id="boundaries" aria-labelledby="boundaries-title">
      <div class="section__heading">
        <p class="section-number">3</p>
        <div><span class="eyebrow">Host responsibility</span><h2 id="boundaries-title">Decision support, not purchase authority</h2></div>
      </div>
      <div class="boundary-grid">
        <p><strong>You provide:</strong> same-product price samples, declared inspection resources, and remaining hard budgets.</p>
        <p><strong>You enforce:</strong> merchant permissions, credentials, actual usage, offer validity, and checkout approval.</p>
        <p><strong>The runtime returns:</strong> feasibility, expected saving, cost components, net value, reservation price, and `SEARCH` or `STOP`.</p>
      </div>
    </section>
  </main>

  <footer>
    <div><p class="footer-title">Agentic Shopping: Search or Stop</p><p>Open source under the MIT License · Version {release.version}</p></div>
    <p><a href={paperHref}>Paper</a> · <a href={links.repository}>GitHub</a></p>
  </footer>
</ResearchLayout>